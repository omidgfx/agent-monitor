        a = sw.get_vadjustment()
        at_bottom = a.get_value() + a.get_page_size() >= a.get_upper() - 30
        if time.time() < follow_state["auto_until"]:
            if (at_bottom and follow_state["user_away"]
                    and follow_state["want_bottom"]):
                print("follow: user_away=False via vadj auto at bottom",
                      file=sys.stderr)
                follow_state["user_away"] = False
                follow_state["want_bottom"] = False
                _update_fab()
            return
        if follow_state["user_away"] != (not at_bottom):
            print("follow: user_away=%s via vadj (val=%.0f upper=%.0f)" %
                  (not at_bottom, a.get_value(), a.get_upper()), file=sys.stderr)
        follow_state["user_away"] = not at_bottom
        if follow_state["user_away"]:
            follow_state["want_bottom"] = False
        _update_fab()

