        def rebuild_list(self):
            for ch in list(self.lbox.get_children()):
                self.lbox.remove(ch)
            for rule in self.rules:
                self.lbox.add(self._row(rule))
            self.lbox.show_all()

        def _row(self, rule):
            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            row.set_activatable(False)
            box = Gtk.Box(spacing=10)
            for m in ("top", "bottom"):
                getattr(box, "set_margin_%s" % m)(6)
            box.set_margin_start(8)
            box.set_margin_end(8)
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            hl = Gtk.Label(xalign=0.0)
            if rule.get("hostname"):
                hl.set_markup("<b>%s</b>" % ESC(rule["hostname"]))
            else:
                hl.set_markup("<b><i>catch-all</i></b>")
            sl = Gtk.Label(xalign=0.0, label=rule.get("service", ""))
            sl.get_style_context().add_class("dim-label")
            vbox.pack_start(hl, False, False, 0)
            vbox.pack_start(sl, False, False, 0)
            box.pack_start(vbox, True, True, 0)
            if rule.get("hostname"):
                btn = Gtk.Button()
                btn.set_image(Gtk.Image.new_from_icon_name(
                    "user-trash-symbolic", Gtk.IconSize.BUTTON))
                btn.set_relief(Gtk.ReliefStyle.NONE)
                btn.set_tooltip_text("Remove rule")
                btn.connect("clicked", self._mk_remove(rule))
                box.pack_start(btn, False, False, 0)
            row.add(box)
            return row

        def _mk_remove(self, rule):
            def rm(*_a):
                self.rules = [r for r in self.rules if r is not rule]
                self.rebuild_list()
                self.set_status("Removed %s \u2014 press Apply to write config"
                                % rule.get("hostname", "?"))
            return rm

        def set_status(self, msg, error=False):
            if error:
                self.s_lbl.set_markup(
                    "<span foreground='#f85149'>%s</span>" % ESC(msg))
            else:
                self.s_lbl.set_text(msg)

        def set_busy(self, busy):
            if busy:
                self.spinner.start()
                self.apply_btn.set_sensitive(False)
            else:
                self.spinner.stop()
                self.apply_btn.set_sensitive(True)

        def on_add(self, *_a):
            h = self.e_host.get_text().strip().lower()
            s = self.e_svc.get_text().strip()
            if not re.match(r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?"
                            r"(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", h):
                self.set_status("Invalid hostname \u2014 use something like app.omidgfx.ir", True)
                return
            if not ("://" in s or s.startswith("http_status:")):
                self.set_status("Service must look like http://localhost:8080 "
                                "or ssh://localhost:22", True)
                return
            if any(r.get("hostname") == h for r in self.rules):
                self.set_status("A rule for %s already exists" % h, True)
                return
            idx = len(self.rules)
            if idx and not self.rules[-1].get("hostname"):
                idx -= 1
            self.rules.insert(idx, {"hostname": h, "service": s})
            self.new_hosts.append((h, self.c_dns.get_active()))
            self.e_host.set_text("")
            self.e_svc.set_text("")
            self.rebuild_list()
            self.set_status("Added %s \u2014 press Apply to save" % h)

        def on_apply(self, *_a):
            tmp = "/tmp/agent-monitor-cf-%d.yml" % os.getpid()
            try:
                with open(tmp, "w", encoding="utf-8") as fh:
                    fh.write(dump_cf_config(self.top, self.rules))
            except OSError as exc:
                self.set_status(str(exc), True)
                return
            self.set_busy(True)
            self.set_status("Validating config\u2026")
            tid = self.tid
            hosts = list(self.new_hosts)
            want_restart = self.c_restart.get_active()

            def work():
                cfbin = shutil.which("cloudflared")
                steps = []
                if cfbin:
                    rc, out = sh([cfbin, "ingress", "validate", "--config", tmp], timeout=40)
                    if rc != 0:
                        GLib.idle_add(self._fail, "Validation failed: " + out[:300])
                        return
                    steps.append("validated")
                else:
                    steps.append("cloudflared not found \u2014 validation skipped")
                ts = time.strftime("%Y%m%d-%H%M%S")
                rc, out = priv_sh(["cp", CF_CONFIG, CF_CONFIG + ".bak-" + ts], timeout=30)
                if rc != 0:
                    GLib.idle_add(self._fail, "Backup failed: " + out[:200])
                    return
                steps.append("backup %s" % ts)
                rc, out = priv_sh(["install", "-m", "644", tmp, CF_CONFIG], timeout=30)
                if rc != 0:
                    GLib.idle_add(self._fail, "Write failed: " + out[:200])
                    return
                steps.append("config written")
                for h, want_dns in hosts:
                    if not want_dns or not tid or not cfbin:
                        steps.append("%s: add CNAME \u2192 %s.cfargotunnel.com manually"
                                     % (h, tid or "<tunnel-id>"))
                        continue
                    rc, out = priv_sh([cfbin, "tunnel", "route", "dns", tid, h], timeout=90)
                    if rc == 0:
                        steps.append("dns %s ok" % h)
                    else:
                        steps.append("dns %s FAILED \u2014 add CNAME \u2192 %s.cfargotunnel.com "
                                     "manually" % (h, tid))
                GLib.idle_add(self._done, steps, want_restart)
            threading.Thread(target=work, daemon=True).start()

        def _fail(self, msg):
            self.set_busy(False)
            self.set_status(msg, True)

        def _done(self, steps, restart):
            self.set_busy(False)
            self.new_hosts = []
            self.set_status(" \u00b7 ".join(steps))
            if restart:
                self.on_restart("restart")

