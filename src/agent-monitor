        GLib.timeout_add(int(os.environ.get("AM_SHOT_DELAY", "2500")), snap)

    Gtk.main()
    return 0


def main(argv):
    if "--selftest" in argv:
        rc = cmd_selftest()
        return token_tests() or rc
    if "--stats" in argv:
        cmd_stats()
        return 0
    if "--context-take" in argv:
        return cmd_context_take()
    if "--rules" in argv:
        return cmd_rules()
    if "--context-add" in argv:
        idx = argv.index("--context-add")
        if len(argv) > idx + 1:
            ctx_add(argv[idx + 1])
            print("context added")
            return 0
    if "--rule-add" in argv:
        idx = argv.index("--rule-add")
        if len(argv) > idx + 1:
            ctx_add(argv[idx + 1], rules=True)
            print("rule added")
            return 0
    if "--version" in argv:
        print("agent-monitor %s" % VERSION)
        return 0
    if "--screenshot" in argv:
        idx = argv.index("--screenshot")
        path = argv[idx + 1] if len(argv) > idx + 1 else "/tmp/agent-monitor-shot.png"
        return run_gui(shot_path=path)
    return run_gui()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
