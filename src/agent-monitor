def _strip(cmd):
    for _ in range(4):
        nxt = ENV_RE.sub("", cmd, count=1)
        nxt = SUDO_RE.sub("", nxt, count=1)
        if nxt == cmd:
            break
        cmd = nxt
    return cmd.strip()


def _classify_one(cmd, depth):
    if REDIR_RE.search(cmd):
        return "write"
    toks = cmd.split()
    if not toks:
        return "read"
    base, sub = toks[0], (toks[1] if len(toks) > 1 else "")

    def has(*words):
        padded = " %s " % " ".join(toks)
        return any((" %s " % w) in padded for w in words)

    if base == "git":
        return "read" if sub in GIT_READ else "write"
    if base == "systemctl":
        return "read" if sub in SYS_READ else "write"
    if base == "journalctl":
        return "read"
    if base == "nmcli":
        return "write" if has("add", "modify", "mod", "up", "down", "delete",
                              "del", "connect", "disconnect", "set") else "read"
    if base in ("apt", "apt-get"):
        return "read" if sub in APT_READ else "write"
    if base == "apt-cache":
        return "read"
    if base == "dpkg":
        readish = ("-l", "-L", "-s", "-S", "-I", "-c", "--list", "--search",
                   "--status", "--contents", "--info", "--verify")
        return "read" if any(sub.startswith(f) for f in readish) else "write"
    if base == "dpkg-query":
        return "read"
    if base == "curl":
        if re.search(r"-X\s*(POST|PUT|PATCH|DELETE)"
                     r"|(^|\s)(-d|--data|-F|--form|-T|--upload)\b"
                     r"|(^|\s)-o\s+(?!/dev/null)", cmd):
            return "write"
        return "read"
    if base == "psql":
        up = cmd.upper()
        reads = re.search(r"\b(SELECT|EXPLAIN|SHOW|\\d|\\l|\\dt)\b", up)
        writes = re.search(r"\b(INSERT|UPDATE|DELETE|ALTER|CREATE|DROP|"
                           r"TRUNCATE|GRANT|REVOKE|COPY)\b", up)
        return "read" if (reads and not writes) else "write"
    if base in ("pg_dump", "pg_dumpall"):
        return "read"
    if base == "pg_restore":
        return "write"
    if base == "php":
        if sub in ("-v", "-m", "-i"):
            return "read"
        if sub == "artisan":
            sub2 = toks[2] if len(toks) > 2 else ""
            return "read" if sub2 in ARTISAN_READ else "write"
        return "write"
    if base in ("python", "python3"):
        if "pip" in cmd:
            return "write"
        if re.search(r"open\([^)]*['\"][wa]", cmd):
            return "write"
        return "read"
    if base == "base64":
        return "write" if ("-d" in toks or "--decode" in toks) else "read"
    if base == "tar":
        return "read" if re.match(r"^\S+\s+-[A-Za-z]*t", cmd) else "write"
    if base == "sed":
        return "write" if ("-i" in toks or "--in-place" in toks) else "read"
    if base in ("bash", "sh", "zsh", "dash"):
        if sub == "-c" and depth < 3:
            return classify(" ".join(toks[2:]), depth + 1)
        args = [t for t in toks[1:] if not t.startswith("-")]
        return "write" if args else "read"
    if base in WRITE_VERBS:
        return "write"
    if base in READ_VERBS:
        return "read"
    return "read"


def classify(raw, depth=0):
    cmd = _strip(raw)
    if not cmd:
        return "read"
    parts = [p.strip() for p in re.split(r"\s*(?:&&|\|\||;|\||\n)\s*", cmd) if p.strip()]
    if not parts:
        return "read"
    for part in parts:
        if _classify_one(part, depth) == "write":
            return "write"
    return "read"


def today_path():
    return os.path.join(LOG_DIR, "commands-%s.log" % _dt.date.today().isoformat())


def jalali_str(dt):
    g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    gy, gm, gd = dt.year, dt.month, dt.day
    gy2 = gy + 1 if gm > 2 else gy
    days = 355666 + 365 * gy + (gy2 + 3) // 4 - (gy2 + 99) // 100 \
        + (gy2 + 399) // 400 + gd + g_d_m[gm - 1]
    jy = -1595 + 33 * (days // 12053)
    days %= 12053
    jy += 4 * (days // 1461)
    days %= 1461
    if days > 365:
        jy += (days - 1) // 365
        days = (days - 1) % 365
    if days < 186:
        jm, jd = 1 + days // 31, 1 + days % 31
    else:
        jm, jd = 7 + (days - 186) // 30, 1 + (days - 186) % 30
    return "%04d/%02d/%02d" % (jy, jm, jd)


def human(n):
    f = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if f < 1024 or unit == "TB":
            return "%.0f %s" % (f, unit) if unit == "B" else "%.1f %s" % (f, unit)
        f /= 1024


def _ts_epoch(s):
    try:
        return _dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


class Store:
    MAX_LINES = 8000

    def __init__(self):
        self.lines = []
        self.offset = 0
        self.path = None
        self.read_ops = self.read_bytes = 0
        self.write_ops = self.write_bytes = 0
        self.last_read = 0.0
        self.last_write = 0.0
        self._load(True, historical=True)

    def _load(self, full, historical=False):
        path = today_path()
        if path != self.path:
            self.path = path
            full = True
            self.offset = 0
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if not os.path.exists(path):
                open(path, "a").close()
        if full:
            self.lines = []
            self.read_ops = self.read_bytes = 0
            self.write_ops = self.write_bytes = 0
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return []
        if size < self.offset:
            self.offset = 0
            self.lines = []
            self.read_ops = self.read_bytes = 0
            self.write_ops = self.write_bytes = 0
        fresh = []
        try:
            with open(self.path, "r", encoding="utf-8", errors="replace") as fh:
                fh.seek(self.offset)
                chunk = fh.read()
                self.offset = fh.tell()
        except OSError:
            return []
        if chunk:
            fresh = [ln for ln in chunk.splitlines() if ln.strip()]
        for ln in fresh:
            self._account(ln, historical)
        return fresh

    def _account(self, ln, historical=False):
        self.lines.append(ln)
        if len(self.lines) > self.MAX_LINES:
            del self.lines[: self.MAX_LINES // 4]
        m = LINE_RE.match(ln)
        cmd = m.group(3) if m else ln
        ts = _ts_epoch(m.group(1)) if m else None
        kind = classify(cmd)
        nbytes = len(cmd.encode("utf-8", "replace"))
        if kind == "write":
            self.write_ops += 1
            self.write_bytes += nbytes
            mark = ts if (historical and ts) else time.time()
            self.last_write = max(self.last_write, mark)
        else:
            self.read_ops += 1
            self.read_bytes += nbytes
            mark = ts if (historical and ts) else time.time()
            self.last_read = max(self.last_read, mark)

    def poll(self):
        return self._load(False)

    def clear(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "w"):
            pass
        self.offset = 0
        self.lines = []
        self.read_ops = self.read_bytes = 0
        self.write_ops = self.write_bytes = 0


def sh(cmd, timeout=120):
    """Run a command, return (returncode, combined output)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except Exception as exc:
        return 127, str(exc)


def priv_sh(cmd, timeout=120):
    """Run a privileged command: sudo -n first, pkexec as fallback."""
    rc, out = sh(["sudo", "-n"] + list(cmd), timeout=timeout)
    if rc != 0 and "password" in out.lower():
        rc, out = sh(["pkexec"] + list(cmd), timeout=timeout)
    return rc, out


def read_cf_config():
    try:
        with open(CF_CONFIG, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        rc, out = sh(["sudo", "-n", "cat", CF_CONFIG], timeout=20)
        if rc == 0:
            return out
        return None


def parse_cf_config(text):
    """Parse the cloudflared config subset: top-level scalar keys + ingress list."""
    top, ingress, cur, in_ing = [], [], None, False
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            in_ing = False
            key, _, val = line.partition(":")
            key, val = key.strip(), val.strip()
            if key == "ingress":
                in_ing = True
            elif key:
                top.append([key, val])
            continue
        if not in_ing:
            continue
        s = line.strip()
        if s.startswith("- "):
            cur = {}
            ingress.append(cur)
            s = s[2:].strip()
        elif s.startswith("-"):
            cur = {}
            ingress.append(cur)
            s = s[1:].strip()
        if cur is not None and ":" in s:
            k, _, v = s.partition(":")
            cur[k.strip()] = v.strip()
    return top, ingress


def dump_cf_config(top, ingress):
    out = []
    for k, v in top:
        out.append("%s: %s" % (k, v))
    out.append("ingress:")
    for r in ingress:
        host = r.get("hostname")
        if host:
            out.append("  - hostname: %s" % host)
            for k, v in r.items():
                if k != "hostname":
                    out.append("    %s: %s" % (k, v))
        else:
            for k, v in r.items():
                out.append("  - %s: %s" % (k, v))
    return "\n".join(out) + "\n"


