def cmd_selftest():
    fails = 0
    for raw, expected in SELFTEST:
        got = classify(raw)
        if got != expected:
            fails += 1
            print("FAIL  %-50r -> %-5s (want %s)" % (raw, got, expected))
    line = "2026-10-07T10:00:00Z [pejman] ls -la /home"
    m = LINE_RE.match(line)
    assert m and m.group(2) == "pejman" and m.group(3) == "ls -la /home"
    cfg = read_cf_config()
    if cfg:
        top, ing = parse_cf_config(cfg)
        assert ing, "no ingress rules parsed"
        assert not ing[-1].get("hostname"), "last rule is not the catch-all"
        rt = parse_cf_config(dump_cf_config(top, ing))
        assert rt == (top, ing), "config roundtrip mismatch"
        tid = next((v for k, v in top if k == "tunnel"), "?")
        print("config: %d ingress rules, roundtrip ok (tunnel %s...)" % (len(ing), tid[:8]))
    else:
        print("config: %s unreadable - skipped" % CF_CONFIG)
    import tempfile
    _base = tempfile.mkdtemp(prefix="am-ctx-")
    ctx_add("hello agent", base=_base)
    ctx_add("second note", base=_base)
    _new, _rules = ctx_take(base=_base)
    assert len(_new) == 2, "ctx take count"
    assert _new[0][2] in ("hello agent", "second note"), "ctx take text"
    _new2, _r2 = ctx_take(base=_base)
    assert not _new2, "ctx take twice not empty"
    ctx_add("rule one", rules=True, base=_base)
    _n3, _r3 = ctx_take(base=_base)
    assert len(_r3) == 1 and _r3[0][2] == "rule one", "ctx rules"
    print("context pool: ok")
    from datetime import date as _date
    for g, j in (((2026, 3, 21), "1405/01/01"), ((2026, 10, 7), "1405/07/15"),
                 ((2026, 10, 8), "1405/07/16"), ((2025, 3, 21), "1404/01/01")):
        got = jalali_str(_date(*g))
        assert got == j, "jalali %s -> %s (want %s)" % (g, got, j)
    print("jalali: ok")
    print("selftest: %d/%d passed" % (len(SELFTEST) - fails, len(SELFTEST)))
    return 1 if fails else 0


