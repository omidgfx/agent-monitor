    def spawn(cmd):
        try:
            subprocess.Popen(cmd, env=os.environ,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError as exc:
            flash("cannot launch: %s" % exc)

    def open_token(tok, kind, force):
        if kind == "url":
            spawn(["xdg-open", tok])
            flash("opening %s" % tok)
            return
        p = os.path.expanduser(tok)
        if not os.path.lexists(p):
            flash("no longer on disk: %s" % p)
            return
        if force:
            spawn(["xdg-open", p])
            flash("opening %s" % p)
        elif shutil.which("nautilus"):
            spawn(["nautilus", "--select", p])
            flash("selecting %s in Files" % p)
        else:
            spawn(["xdg-open", os.path.dirname(p) or "/"])
            flash("opening folder of %s" % p)

    def _token_at(event):
        bx, by = tv.window_to_buffer_coords(
            Gtk.TextWindowType.WIDGET, int(event.x), int(event.y))
        res = tv.get_iter_at_location(bx, by)
        if not res or not res[0]:
            return None
        for t in res[1].get_tags() or []:
            tok = getattr(t, "token", None)
            if tok:
                return (tok, getattr(t, "kind", None))
        return None

    def on_button_press(_tv, event):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        hit = _token_at(event)
        if not hit:
            return False
        tok, kind = hit
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if event.button == 2 or (event.button == 1 and ctrl):
            open_token(tok, kind, True)
        elif event.button == 1:
            open_token(tok, kind, False)
        else:
            return False
        return True

    def on_motion(_tv, event):
        win_t = tv.get_window(Gtk.TextWindowType.TEXT)
        if win_t is None:
            return False
        hit = _token_at(event)
        try:
            cur = Gdk.Cursor.new_from_name(win_t.get_display(),
                                           "pointer" if hit else "text")
        except Exception:
            cur = Gdk.Cursor.new(
                Gdk.CursorType.HAND2 if hit else Gdk.CursorType.XTERM)
        win_t.set_cursor(cur)
        return False

    tv.connect("button-press-event", on_button_press)
    tv.add_events(Gdk.EventMask.POINTER_MOTION_MASK)
    tv.connect("motion-notify-event", on_motion)


