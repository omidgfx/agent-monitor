        if event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            if not follow_state["user_away"]:
                print("follow: user_away=True via wheel", file=sys.stderr)
                follow_state["user_away"] = True
                follow_state["want_bottom"] = False
                _update_fab()
        elif event.direction == Gdk.ScrollDirection.DOWN:
            a = sw.get_vadjustment()
            if a.get_value() + a.get_page_size() >= a.get_upper() - 30:
                if follow_state["user_away"]:
                    print("follow: user_away=False via wheel at bottom", file=sys.stderr)
                    follow_state["user_away"] = False
                    _update_fab()
        return False

