    def draw_dash(cr, x0, x1, y, direction, last, flux, off):
        p = state["pal"]
        glow = max(0.0, 1.0 - (time.time() - last) / 3.0) if last else 0.0
        active = flux > 0.05
        intensity = max(glow, 0.3 if active else 0.0)
        _target = p["amber"] if direction == "right" else p["green"]
        cr.set_source_rgb(*mix(p["idle"], _target, intensity))
        cr.set_line_width(2.0 if glow > 0.05 else 1.5)
        cr.set_dash([5.0, 4.0], off)
        cr.move_to(x0, y)
        cr.line_to(x1, y)
        cr.stroke()
        cr.set_dash([], 0)
        head = 7
        if direction == "left":
            hx = x0 - 2
            cr.move_to(hx, y)
            cr.line_to(hx + head, y - 4)
            cr.line_to(hx + head, y + 4)
        else:
            hx = x1 + 2
            cr.move_to(hx, y)
            cr.line_to(hx - head, y - 4)
            cr.line_to(hx - head, y + 4)
        cr.close_path()
        cr.fill()
        return intensity

    def _lbl_markup(lbl, text, last, p):
        lbl.set_text(text)

    def on_draw(_w, cr):
        y = 12
        draw_dash(cr, 8, 72, y, "left", store.last_read,
                  state["flux_r"], state["off_r"])
        draw_dash(cr, 98, 162, y, "right", store.last_write,
                  state["flux_w"], state["off_w"])
        return False

    arrows.connect("draw", on_draw)

    def tick_anim():
        for flux_key, off_key, direction in (("flux_r", "off_r", "left"),
                                             ("flux_w", "off_w", "right")):
            flux = state[flux_key]
            if flux > 0.05:
                speed = min(3.0, 0.5 + flux * 0.45)
                state[off_key] = (state[off_key] + speed if direction == "left"
                                  else state[off_key] - speed)
            state[flux_key] = flux * 0.90
        arrows.queue_draw()
        return True

    # ---- tunnel status / actions ------------------------------------------------
    def set_pill(state_name, extra=""):
        state["pill_state"] = (state_name, extra)
        p = state["pal"]
        colors = {"up": p["pill_up"], "connecting": p["pill_conn"],
                  "failed": p["pill_fail"], "stopped": p["pill_stop"],
                  "restarting": p["pill_conn"]}
        texts = {"up": "tunnel up", "connecting": "tunnel connecting",
                 "failed": "tunnel failed", "stopped": "tunnel stopped",
                 "restarting": "restarting\u2026"}
        c = colors.get(state_name, p["pill_stop"])
        t = texts.get(state_name, state_name)
        s = "<span weight='bold' foreground='%s'>\u25cf</span>  %s" % (c, t)
        if extra:
            s += "  <span foreground='%s'>\u00b7</span>  %s" % (p["pill_stop"], ESC(extra))
        tunnel_lbl.set_markup(s)

    def refresh_tunnel():
        def work():
            rc, out = sh(["systemctl", "is-active", CF_SERVICE], timeout=6)
            svc = out.strip().splitlines()[-1] if out.strip() else "unknown"
            links, egress = "", ""
            if svc == "active":
                try:
                    import socket
                    socket.setdefaulttimeout(1.0)
                    body = urllib.request.urlopen(METRICS_URL).read().decode("utf-8", "replace")
                    m = re.search(r"cloudflared_tunnel_ha_connections (\d+)", body)
                    if m:
                        links = "%s links" % m.group(1)
                except Exception:
                    pass
                try:
                    with open(STATUS_JSON, encoding="utf-8") as fh:
                        egress = json.load(fh).get("egress", "")
                except Exception:
                    pass
            GLib.idle_add(lambda: apply_tunnel_state(svc, links, egress))
        threading.Thread(target=work, daemon=True).start()

    def apply_tunnel_state(svc, links, egress):
        if svc == "active":
            state_name = "up"
            m = re.match(r"(\d+) links", links)
            if m and int(m.group(1)) == 0:
                state_name = "connecting"
        elif svc in ("activating", "reloading"):
            state_name = "connecting"
        elif svc == "failed":
            state_name = "failed"
        else:
            state_name = "stopped"
        set_pill(state_name, links)
        tunnel_mb.set_tooltip_text(
            "cloudflared.service: %s%s" % (svc, (" \u00b7 egress " + egress) if egress else ""))

    def show_err(title, msg):
        d = Gtk.MessageDialog(transient_for=win, modal=True,
                              message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE, text=title)
        d.format_secondary_text(msg)
        d.run()
        d.destroy()

    def do_action(action):
        if action == "stop":
            dlg = Gtk.MessageDialog(
                transient_for=win, modal=True,
                message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.OK_CANCEL,
                text="Stop the Cloudflare tunnel?")
            dlg.format_secondary_text(
                "Public hostnames (pc / sandbox / \u2026) go offline until you press "
                "Start.\nIf you are connected over SSH through the tunnel, that "
                "session will drop.")
            if dlg.run() != Gtk.ResponseType.OK:
                dlg.destroy()
                return
            dlg.destroy()
        cmds = {"restart": ["systemctl", "restart", CF_SERVICE],
                "stop": ["systemctl", "stop", CF_SERVICE],
                "start": ["systemctl", "start", CF_SERVICE]}
        set_pill({"restart": "restarting", "stop": "stopped",
                  "start": "connecting"}[action])

        def work():
            rc, out = priv_sh(cmds[action], timeout=90)
            GLib.idle_add(lambda: after_action(rc, out))
        threading.Thread(target=work, daemon=True).start()

    def after_action(rc, out):
        refresh_tunnel()
        for d in (2, 6, 15, 30):
            GLib.timeout_add_seconds(d, refresh_tunnel)
        if rc != 0:
            show_err("Tunnel action failed", out[:400])

