    def fmt_ts(s):
        try:
            dt = _dt.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone()
        except Exception:
            return s
        if state["dates"] == "jalali":
            return "%s %s" % (jalali_str(dt), dt.strftime("%H:%M:%S"))
        return "%s %s" % (dt.strftime("%Y-%m-%d"), dt.strftime("%H:%M:%S"))

    def _hl_range(start_off, text):
        if not filter_text:
            return
        low = text.lower()
        i = low.find(filter_text)
        while i != -1:
            buf.apply_tag_by_name(
                "hl", buf.get_iter_at_offset(start_off + i),
                buf.get_iter_at_offset(start_off + i + len(filter_text)))
            i = low.find(filter_text, i + len(filter_text))

    def insert_line(ln):
        # display-only truncation: pathological lines (e.g. embedded base64
        # blobs) would otherwise wrap into thousands of rows and stall layout
        if len(ln) > 400:
            ln = ln[:400] + " \u2026 +%d chars" % (len(ln) - 400)
        line_start = buf.get_char_count()
        m = LINE_RE.match(ln)
        if m:
            _ts = fmt_ts(m.group(1))
            _s = buf.get_char_count()
            buf.insert_with_tags_by_name(buf.get_end_iter(), _ts, "ts")
            _hl_range(_s, _ts)
            _s = buf.get_char_count()
            buf.insert_with_tags_by_name(
                buf.get_end_iter(), "  [" + m.group(2) + "]  ", "user")
            _hl_range(_s, "  [" + m.group(2) + "]  ")
            cmd_start = buf.get_char_count()
            cmd = m.group(3)
            buf.insert_with_tags_by_name(
                buf.get_end_iter(), cmd, "wr" if classify(cmd) == "write" else "rd")
            _hl_range(cmd_start, cmd)
            p = state["pal"]
            for kind, a, b, tok in find_tokens(cmd):
                t = buf.create_tag(
                    None, foreground=p["url"] if kind == "url" else p["link"],
                    underline=Pango.Underline.SINGLE)
                t.token = tok
                t.kind = kind
                buf.apply_tag(t, buf.get_iter_at_offset(cmd_start + a),
                              buf.get_iter_at_offset(cmd_start + b))
        else:
            cmd_start = buf.get_char_count()
            buf.insert_with_tags_by_name(buf.get_end_iter(), ln, "rd")
            _hl_range(cmd_start, ln)
            p = state["pal"]
            for kind, a, b, tok in find_tokens(ln):
                t = buf.create_tag(
                    None, foreground=p["url"] if kind == "url" else p["link"],
                    underline=Pango.Underline.SINGLE)
                t.token = tok
                t.kind = kind
                buf.apply_tag(t, buf.get_iter_at_offset(cmd_start + a),
                              buf.get_iter_at_offset(cmd_start + b))
        buf.insert(buf.get_end_iter(), "\n")
        if shown[0] % 2 == 1:
            buf.apply_tag_by_name("even", buf.get_iter_at_offset(line_start),
                                  buf.get_iter_at_offset(buf.get_char_count()))
