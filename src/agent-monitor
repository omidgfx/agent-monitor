CTX_BASE = os.environ.get("AGENT_MONITOR_CTX_DIR") or os.path.join(
    HOME, ".agent-monitor", "context")


def _ctx_dirs(base=None):
    b = base or CTX_BASE
    return (os.path.join(b, "pending"), os.path.join(b, "read"),
            os.path.join(b, "rules"))


def ctx_ensure(base=None):
    for d in _ctx_dirs(base):
        os.makedirs(d, exist_ok=True)


def ctx_add(text, rules=False, base=None):
    """Owner (or CLI) adds a context item / permanent rule. Returns item id."""
    ctx_ensure(base)
    pend, _rd, rul = _ctx_dirs(base)
    kind = "rule" if rules else "ctx"
    d = rul if rules else pend
    ts = time.strftime("%Y%m%d-%H%M%S")
    n = 1
    while os.path.exists(os.path.join(d, "%s-%s-%02d.md" % (kind, ts, n))):
        n += 1
    path = os.path.join(d, "%s-%s-%02d.md" % (kind, ts, n))
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text.strip() + "\n")
    return os.path.basename(path)[:-3]


def _ctx_items(d):
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".md"):
            continue
        try:
            with open(os.path.join(d, name), encoding="utf-8") as fh:
                text = fh.read().strip()
        except OSError:
            continue
        if text:
            out.append((name[:-3], "-".join(name.split("-")[1:3]), text))
    return out


def ctx_take(base=None):
    """Return (new_items, rules). Moves pending -> read (rules stay forever)."""
    ctx_ensure(base)
    pend, rd, rul = _ctx_dirs(base)
    new = []
    for cid, when, text in list(_ctx_items(pend)):
        try:
            os.replace(os.path.join(pend, cid + ".md"), os.path.join(rd, cid + ".md"))
            new.append((cid, when, text))
        except OSError:
            pass
    return new, _ctx_items(rul)


def cmd_context_take():
    new, rules = ctx_take()
    print("=== NEW CONTEXT (now marked read) ===")
    if new:
        for cid, when, text in new:
            print("[%s] %s" % (cid, when))
            print(text)
    else:
        print("(none)")
    print("=== RULES (permanent - always apply) ===")
    if rules:
        for cid, _when, text in rules:
            print("[%s]" % cid)
            print(text)
    else:
        print("(none)")
    print("=== END ===")
    return 0


def cmd_rules():
    _pend, _rd, rul = _ctx_dirs()
    rules = _ctx_items(rul)
    if rules:
        for cid, _when, text in rules:
            print("[%s]" % cid)
            print(text)
    else:
        print("(no rules)")
    return 0


URL_RE = re.compile(r"https?://[^\s\"'<>()\[\]]+")
PATH_RE = re.compile(r"~/?(?:[A-Za-z0-9._@+-]+/)*[A-Za-z0-9._@+-]*"
                     r"|/(?:[A-Za-z0-9._@+-]+/)*[A-Za-z0-9._@+-]+")


def find_tokens(text):
    """Return [(kind, start, end, token)] for URLs and file-system paths."""
    out, spans = [], []
    for m in URL_RE.finditer(text):
        tok = m.group(0).rstrip(".,;:)]}>")
        if len(tok) > 8:
            a = m.start()
            spans.append((a, a + len(tok)))
            out.append(("url", a, a + len(tok), tok))
    for m in PATH_RE.finditer(text):
        a, b = m.start(), m.end()
        if any(a < sb and b > sa for sa, sb in spans):
            continue
        tok = text[a:b].rstrip(".,;")
        if len(tok) < 2 or tok in ("~", "~/", "/"):
            continue
        out.append(("path", a, a + len(tok), tok))
    out.sort(key=lambda r: r[1])
    return out


def token_tests():
    t1 = find_tokens("cat /etc/hosts && curl -s https://ex.ir/a?b=1 | base64 -d > ~/out.txt")
    g1 = [(k, t) for k, a, b, t in t1]
    w1 = [("path", "/etc/hosts"), ("url", "https://ex.ir/a?b=1"), ("path", "~/out.txt")]
    t2 = find_tokens('cp "/etc/cloudflared/config.yml" /tmp/x.yml; see https://a.b/c.')
    g2 = [(k, t) for k, a, b, t in t2]
    w2 = [("path", "/etc/cloudflared/config.yml"), ("path", "/tmp/x.yml"),
          ("url", "https://a.b/c")]
    ok = g1 == w1 and g2 == w2
    if not ok:
        print("token FAIL: %r %r" % (g1, g2))
    else:
        print("tokens: ok")
    return 0 if ok else 1


