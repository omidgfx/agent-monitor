                    state["flux_w"] += 1.0
                else:
                    state["flux_r"] += 1.0
            if filter_text:
                rebuild()
            else:
                for ln in fresh:
                    insert_line(ln)
                if buf.get_line_count() > 9000:
                    buf.delete(buf.get_start_iter(), buf.get_iter_at_line(3000))
            if follow.get_active() and not follow_state["user_away"]:
                scroll_end()
        refresh_status()
        return True

